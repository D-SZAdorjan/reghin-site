generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_DATABASE_URL")
  directUrl = env("SUPABASE_DIRECT_URL")
}

model Article {
  id              BigInt           @id @default(autoincrement())
  title           Json?            @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  subtitle        Json?            @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  image           String?
  lead            Json?            @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  content         Json?            @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  published        Boolean?          @default(false)
  category_id     BigInt?
  ArticleCategory ArticleCategory? @relation(fields: [category_id], references: [id])
  start_date      DateTime?        @default(now()) @db.Timestamp(6)
  end_date        DateTime?        @default(now()) @db.Timestamp(6)
  updated_at      DateTime?        @default(now()) @db.Timestamptz(6)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
}

model ArticleCategory {
  id         BigInt    @id @default(autoincrement())
  name       Json?     @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  priority   BigInt?   @default(0)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  Article    Article[]
}

model Monument {
  id               BigInt            @id @default(autoincrement())
  name             Json?             @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  image            String?
  description      Json?             @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  open_hours       Json?             @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  address          Json?             @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  contact_info     Json?             @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  map_link         String?           @default("") @db.VarChar
  category_id      BigInt?
  MonumentCategory MonumentCategory? @relation(fields: [category_id], references: [id])
  is_visitable     Boolean?          @default(false)
  priority         BigInt?           @default(0)
  published        Boolean?          @default(false)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?         @default(now()) @db.Timestamptz(6)
}

model MonumentCategory {
  id         BigInt     @id @default(autoincrement())
  name       Json?      @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  priority   BigInt?    @default(0)
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  Monument   Monument[]
}

model NotablePersonality {
  id          BigInt    @id @default(autoincrement())
  first_name  String?   @default("") @db.VarChar
  last_name   String?   @default("") @db.VarChar
  image       String?
  description Json?     @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  occupation  Json?     @default("{\"de\": \"\", \"en\": \"\", \"fr\": \"\", \"hu\": \"\", \"ro\": \"\"}")
  priority    BigInt?   @default(0)
  published   Boolean?  @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}